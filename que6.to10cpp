/* Que 10 - Write a program to determine if a three digit number is a palindrome. [no loops allowed , only if-else logic] */
#include <iostream>
using namespace std;

int main() {
    int number, firstDigit, lastDigit;

    cout << "Enter a three-digit number: ";
    if (!(cin >> number) || number < 100 || number > 999) {
        cerr << "Invalid input. Please enter a three-digit number." << endl;
        return 1;
    }

    firstDigit = number / 100;
    lastDigit = number % 10;

    if (firstDigit == lastDigit) {
        cout << "The number is a palindrome." << endl;
    } else {
        cout << "The number is not a palindrome." << endl;
    }

    return 0;
}
/* Que 10 - Write a program to determine if a three digit number is a palindrome. use only if else*/
#include <iostream>
using namespace std;
int main() {
    int num, firstDigit, seconddigit , thirddigit;
    cout << "Enter a three-digit number: ";
    if (!(cin >> num) || num < 100 || num > 999) {
        cerr << "Invalid input. Please enter a three-digit number." << endl;
        return 1;
    }
    firstDigit = num / 100;
    seconddigit = (num / 10) % 10;
    thirddigit = num % 10;
    if (firstDigit == thirddigit) {
        cout << "The number is a palindrome." << endl;
    } else {
        cout << "The number is not a palindrome." << endl;
    }
    return 0;
}
